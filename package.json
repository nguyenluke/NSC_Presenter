{
  "name": "nsc-presenter",
  "version": "0.1.6",
  "description": "NSC Presenter — Bilingual Multi-Screen Worship & Live Visual Studio",
  "main": "./out/main/index.js",
  "author": "NSC Worship Team",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist:win": "npm run build && electron-builder --win",
    "dist:win:zip": "npm run build && electron-builder --win zip",
    "dist:mac": "npm run build && electron-builder --mac",
    "test:sync": "node --test tests/song-sync.test.cjs",
    "test:pads": "node --test tests/worship-pads.test.cjs",
    "test:studio": "npm run build && node --test tests/studio-settings.test.cjs tests/studio-layout-render.test.cjs tests/temporary-song-edits.test.cjs",
    "test:documents": "npm run build && node --test tests/document-import.test.cjs"
  },
  "dependencies": {
    "lucide-react": "^0.460.0",
    "sql.js": "^1.12.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "org.nscchurch.presenter",
    "productName": "NSC Presenter",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "node_modules/sql.js/dist/sql-wasm.wasm"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "NSC-Presenter-${version}-${arch}.${ext}"
    },
    "nsis": {
      "artifactName": "NSC-Presenter-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NSC Presenter",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "mac": {
      "target": "dmg"
    }
  }
}
